# Render/backend environment template. Copy values into encrypted Render environment variables.
# Never commit real credentials. Rotate any credential previously committed to this file.

PORT=10000
FRONTEND_URL=https://creator-hub-live-frontend.onrender.com

# Supabase — public URL/key may be public; service role must remain server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_RENDER_AFTER_ROTATION

# LiveKit — rotate API credentials if they were previously committed.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=SET_IN_RENDER_AFTER_ROTATION
LIVEKIT_API_SECRET=SET_IN_RENDER_AFTER_ROTATION

# PayPal. Start in sandbox; enable live processing only after fresh credentials,
# webhook verification, payment reconciliation, and payout eligibility checks.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=SET_IN_RENDER_AFTER_ROTATION
PAYPAL_CLIENT_SECRET=SET_IN_RENDER_AFTER_ROTATION
PAYPAL_WEBHOOK_ID=SET_IN_RENDER_AFTER_ROTATION

# Wallet conversion — set only after the CHL ledger/rates are validated.
CHL_COINS_PER_DIAMOND=
CHL_DIAMONDS_PER_COIN=

# Optional LIVE recording support (private S3-compatible bucket only).
LIVE_RECORDING_S3_BUCKET=
LIVE_RECORDING_S3_REGION=
LIVE_RECORDING_S3_ACCESS_KEY=
LIVE_RECORDING_S3_SECRET_KEY=
LIVE_RECORDING_S3_ENDPOINT=
LIVE_RECORDING_S3_FORCE_PATH_STYLE=false
LIVE_RECORDING_CLEANUP_SECRET=
